# ==============================
# 🌐 APP CONFIG
# ==============================
NODE_ENV=development
PORT=3000

# ==============================
# 🔐 AUTH (Clerk)
# ==============================

# Public key (safe for frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Secret key (backend only - keep secure)
CLERK_SECRET_KEY=your_clerk_secret_key

# ==============================
# 🧠 ML API (FastAPI Service)
# ==============================

# Endpoint for cattle/buffalo breed prediction
# Example (local): http://localhost:8000/predict
# Example (prod): https://your-fastapi-service/predict
FASTAPI_URL=your_fastapi_endpoint

# ==============================
# 🗄 DATABASE (Supabase)
# ==============================

# Supabase project URL
SUPABASE_URL=your_supabase_project_url

# Supabase anon/public key
SUPABASE_ANON_KEY=your_supabase_anon_key

# ==============================
# ⚡ CACHE / KV (Optional - Vercel KV / Upstash)
# ==============================

# Uncomment if using KV storage

# KV_REST_API_URL=your_kv_rest_api_url
# KV_REST_API_TOKEN=your_kv_rest_api_token
